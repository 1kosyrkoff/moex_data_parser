# Generate three different values, e.g. with: openssl rand -hex 32
BOND_DB_PASSWORD=
BOND_WRITER_PASSWORD=
BOND_READER_PASSWORD=
# 127.0.0.1 for local access; 0.0.0.0 to publish on all IPv4 interfaces.
BOND_API_HOST=0.0.0.0
BOND_API_PORT=8793
# Database port is published on VM loopback only.
BOND_DB_PORT=5432
# Complete current MOEX list; use --limit N only for an explicit trial run.
BOND_RUN_ARGS=--history-days 365
# Interval after a completed run; first run starts immediately.
BOND_UPDATE_INTERVAL=86400
BOND_RUN_TIMEOUT=43200
SOURCE_REVISION=unknown
