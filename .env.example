# Generate four different values, e.g. with: openssl rand -hex 32
BOND_DB_PASSWORD=
BOND_WRITER_PASSWORD=
BOND_READER_PASSWORD=
BOND_API_TOKEN=
BOND_API_PORT=8793
# Start with five issues; remove --limit to collect the complete MOEX list.
BOND_RUN_ARGS=--limit 5 --history-days 30
# Interval after a completed run; first run starts immediately.
BOND_UPDATE_INTERVAL=86400
BOND_RUN_TIMEOUT=43200
SOURCE_REVISION=unknown
